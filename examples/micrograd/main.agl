package main

import (
    "fmt"
    "math/rand"
)

type Value struct {
    mut Data f64
    mut Grad f64
    mut backward func()
    mut prev set[*Value]
    mut op string
}
func (v Value) String() string {
    return fmt.Sprintf("V(data:%v grad:%v)", v.Data, v.Grad)
}
func NewValue(data f64, children []*Value) *Value {
    return &Value {
        Data: data,
        backward: func() {},
        prev: Set(children),
    }
}
func NewValue1(data f64) *Value {
    return NewValue(data, []*Value{})
}
func (mut v *Value) + (mut other *Value) *Value {
    mut out := NewValue(v.Data + other.Data, []*Value{v, other})
    out.backward = func() {
        v.Grad += out.Grad
        other.Grad += out.Grad
    }
    return out
}
func (mut v *Value) * (mut other *Value) *Value {
    mut out := NewValue(v.Data * other.Data, []*Value{v, other})
    out.backward = func() {
        v.Grad += other.Data * out.Grad
        other.Grad += v.Data * out.Grad
    }
    return out
}
func (mut v *Value) ** (other f64) *Value {
    mut out := NewValue(v.Data ** other, []*Value{v})
    out.backward = func() {
        v.Grad += other * (v.Data ** (other-1)) * out.Grad
    }
    return out
}
func (mut v *Value) + (other f64) *Value {
    return v + NewValue1(other)
}
func (mut v *Value) * (other f64) *Value {
    return v * NewValue1(other)
}
func (mut v *Value) - (other *Value) *Value {
    return v + -other
}
func (mut v *Value) / (other *Value) *Value {
    return v * other ** -1.0
}
func (mut v *Value) / (other f64) *Value {
    return v * other ** -1.0
}
func (mut v *Value) __RQUO (other f64) *Value {
    return other * v ** -1.0
}
func (mut v *Value) __RADD (other f64) *Value {
    return v + other
}
func (mut v *Value) __RMUL (other f64) *Value {
    return v * other
}
func (mut v *Value) __NEG() *Value {
    return v * -1.0
}
func (mut v *Value) Relu() *Value {
    mut out := NewValue((if v.Data < 0.0 { 0.0 } else { v.Data }), []*Value{v})
    out.backward = func() {
        v.Grad += if out.Data > 0.0 { out.Grad } else { 0.0 }
    }
    return out
}

func buildTopo(v *Value, mut visited set[*Value], mut topo *[]*Value) {
    if visited.Insert(v) {
        for child in v.prev {
            buildTopo(child, mut visited, mut topo)
        }
        topo.Push(v)
    }
}

func (mut v *Value) Backward() {
    var mut topo []*Value
    mut visited := set[*Value]{}
    buildTopo(v, mut visited, &mut topo)
    v.Grad = 1.0
    for el in topo.Reversed() {
        el.backward()
    }
}

type Module struct {
}

func (m *Module) ZeroGrad() {
    for p in m.Parameters() {
        mut p := p
        p.Grad = 0
    }
}

func (m *Module) Parameters() []*Value {
    return make([]*Value, 0)
}

type Neuron struct {
    mut W []*Value
    mut B *Value
    Nonlin bool
}

func NewNeuron(nin int, nonlin bool) *Neuron {
    mut n := &Neuron{Nonlin: nonlin}
    for _ in 0..nin {
        n.W.Push(NewValue1(-1+rand.Float64()*2))
    }
    n.B = NewValue1(0)
    return n
}

func (n *Neuron) Parameters() []*Value {
    return n.W + []*Value{n.B}
}

func (n *Neuron) Call(x []*Value) *Value {
    mut act := n.B
    for (wi, xi) in zip(n.W, x) {
        act += wi * xi
    }
    return if n.Nonlin { act.Relu() } else { act }
}

type Layer struct {
    mut Neurons []*Neuron
}

func NewLayer(nin, nout int, nonlin bool) *Layer {
    mut l := &Layer{}
    for _ in 0..nout {
        l.Neurons.Push(NewNeuron(nin, nonlin))
    }
    return l
}

func (l *Layer) Call(x []*Value) []*Value {
    mut out := make([]*Value, 0)
    for n in l.Neurons {
        out.Push(n.Call(x))
    }
    return out
}

func (l *Layer) Parameters() []*Value {
    l.Neurons.FlatMap(|neuron| neuron.Parameters())
}

type MLP struct {
    mut Layers []*Layer
}

func NewMLP(nin int, nouts []int) *MLP {
    mut m := &MLP{}
    sz := append([]int{nin}, nouts...)
    m.Layers = make([]*Layer, 0)
    for i in 0..nouts.Len() {
        m.Layers.Push(NewLayer(sz[i], sz[i+1], i!=nouts.Len()-1))
    }
    return m
}

func (m *MLP) Call(x []*Value) []*Value {
    mut out := x
    for layer in m.Layers {
        out = layer.Call(out)
    }
    return out
}

func (m *MLP) Parameters() []*Value {
    m.Layers.FlatMap(|layer| layer.Parameters())
}

func main() {
    a := NewValue1(-4.0)
    b := NewValue1(2.0)
    mut c := a + b
    mut d := a * b + b**3
    c += c + 1
    c += f64(1) + c + -a
    d += d * 2 + (b + a).Relu()
    d += f64(3) * d + (b - a).Relu()
    e := c - d
    f := e**2
    mut g := f / 2
    g += f64(10) / f
    assertEq(fmt.Sprintf("%.4f", g.Data), "24.7041")
    fmt.Printf("%.4f\n", g.Data) // prints 24.7041, the outcome of this forward pass
    g.Backward()
    assertEq(fmt.Sprintf("%.4f", a.Grad), "138.8338")
    assertEq(fmt.Sprintf("%.4f", b.Grad), "645.5773")
    fmt.Printf("%.4f\n", a.Grad) // prints 138.8338, i.e. the numerical value of dg/da
    fmt.Printf("%.4f\n", b.Grad) // prints 645.5773, i.e. the numerical value of dg/db
}