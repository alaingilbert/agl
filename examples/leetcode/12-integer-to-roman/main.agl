package main

func intToRoman(num int) string {
    a1 := []int{1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1}
    a2 := []string{"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"}
    mut num := num
    mut res := ""
    mut i := 0
    for num > 0 {
        if num >= a1[i] {
            num -= a1[i]
            res += a2[i]
        } else {
            i++
        }
    }
    return res
}

func main() {
    assertEq(intToRoman(3749), "MMMDCCXLIX")
    assertEq(intToRoman(58), "LVIII")
    assertEq(intToRoman(1994), "MCMXCIV")
    assertEq(intToRoman(400), "CD")
}