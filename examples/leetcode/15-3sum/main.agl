package main

func threeSum(nums []int) [][]int {
    mut res := set[(int, int, int)]{}
    for (i1, e1) in nums.Enumerated() {
        for (i2, e2) in nums.Enumerated() where i2 != i1 {
            for (i3, e3) in nums.Enumerated() where i3 != i2 && i3 != i1 {
                if e1 + e2 + e3 == 0 {
                    e := []int{e1, e2, e3}.Sorted()
                    res.Insert((e[0], e[1], e[2]))
                }
            }
        }
    }
    mut out := make([][]int, 0)
    for el in res {
        out.Push([]int{el.0, el.1, el.2})
    }
    return out
}

func main() {
    print(threeSum([]int{-1,0,1,2,-1,-4}))
    print(threeSum([]int{-100,-70,-60,110,120,130,160}))
    print(threeSum([]int{13,-11,-14,4,-9,-10,-11,7,-14,-9,14,0,-5,-7,6,-9,11,6,-14,-12,-10,9,-8,-7,5,6,8,-12,-1,-4,14,-3,0,7,9,7,12,13,-9,13,11,-10,-10,-9,-10,12,-10,8,-5,13,11,-8,7,-12,0,-11,2,-14,-8,8,-3,13,-9,5,5,7,-11,-6,5,-13,-7,1,14,-10,-1,-11,-13,4,12,-11,2,0,-4,-14,4,4,-10,13,-3,-10,6,1,-12,4,-9,1,-4,-13,10,8,-11,10,-14,-12,-14,1,-8,10,-10,11,-15,0,-3,-12,1,-14,-1,-1,6,11,-4,-3,-2,-1,-13}))
//     assertEq(threeSum([]int{-1,0,1,2,-1,-4}), [][]int{{-1,-1,2},{-1,0,1}})
//     assertEq(threeSum([]int{0,1,1}), [][]int{})
