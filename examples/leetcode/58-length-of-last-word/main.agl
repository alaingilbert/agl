package main

func lengthOfLastWord(s string) int {
    mut p, mut l := s.Len(), 0
    for p > 0 {
        p--
        if s[p] != ' ' {
            l++
        } else if l > 0 {
            return l
        }
    }
    return l
}

func main() {
    assertEq(lengthOfLastWord("Hello World"), 5)
    assertEq(lengthOfLastWord("   fly me   to   the moon  "), 4)
    assertEq(lengthOfLastWord("luffy is still joyboy"), 6)
}