package main

type TreeNode struct {
    Val int
    Left *TreeNode
    Right *TreeNode
}

func postorderTraversal(root *TreeNode) []int {
    if root == nil {
        return []int{}
    }
    if root.Left == nil && root.Right == nil {
        return []int{root.Val}
    }
    mut out := []int{}
    if root.Left != nil {
        a := postorderTraversal(root.Left)
        out.Push(a...)
    }
    if root.Right != nil {
        b := postorderTraversal(root.Right)
        out.Push(b...)
    }
    out.Push(root.Val)
    return out
}

func main() {
}