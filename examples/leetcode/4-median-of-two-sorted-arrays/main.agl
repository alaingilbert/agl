package main

func findMedianSortedArrays(nums1 []int, nums2 []int) f64 {
    var mut p1, mut p2 int
    mut merged := []int{}
    for p1 < nums1.Len() || p2 < nums2.Len() {
        if p1 < nums1.Len() && p2 < nums2.Len() {
            if nums1[p1] <= nums2[p2] {
                merged.Push(nums1[p1])
                p1++
            } else {
                merged.Push(nums2[p2])
                p2++
            }
        } else if p1 < nums1.Len() {
            merged.Push(nums1[p1])
            p1++
        } else if p2 < nums2.Len() {
            merged.Push(nums2[p2])
            p2++
        }
    }
    l := merged.Len()
    if l % 2 == 0 {
        return f64(merged[l/2-1] + merged[l/2]) / 2.0
    } else {
        return f64(merged[l/2])
    }
}

func main() {
    assertEq(findMedianSortedArrays([]int{1, 3}, []int{2}), 2.0)
    assertEq(findMedianSortedArrays([]int{1, 2}, []int{3, 4}), 2.5)
}