package main

func jump(nums []int) int {
    mut ans, n := 0, nums.Len()
    var mut curEnd, mut curFar int
    for i in 0..n-1 {
        curFar = max(curFar, i+nums[i])
        if i == curEnd {
            ans++
            curEnd = curFar
        }
    }
    return ans
}

func main() {
    assertEq(jump([]int{2,3,1,1,4}), 2)
    assertEq(jump([]int{2,3,0,1,4}), 2)
    assertEq(jump([]int{1,2,1,1,1}), 3)
    assertEq(jump([]int{5,6,4,4,6,9,4,4,7,4,4,8,2,6,8,1,5,9,6,5,2,7,9,7,9,6,9,4,1,6,8,8,4,4,2,0,3,8,5}), 5)
}