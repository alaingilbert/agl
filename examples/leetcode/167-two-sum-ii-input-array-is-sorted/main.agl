package main

import "slices"

func twoSum(numbers []int, target int) []int {
    mut lo, mut hi := 0, numbers.Len()-1
    for hi > lo {
        sum := numbers[lo] + numbers[hi]
        if sum == target {
            return []int{lo+1, hi+1}
        } else if sum > target {
            hi--
        } else {
            lo++
        }
    }
    return []int{}
}

func main() {
    assert(slices.Equal(twoSum([]int{2,7,11,15}, 9), []int{1,2}))
    assert(slices.Equal(twoSum([]int{2,3,4}, 6), []int{1,3}))
    assert(slices.Equal(twoSum([]int{-1,0}, -1), []int{1,2}))
}