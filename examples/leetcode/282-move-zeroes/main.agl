package main

func moveZeroes(mut nums []int)  {
    mut lastNonZero := 0
    for curr := 0; curr < nums.Len(); curr++ {
        if nums[curr] != 0 {
            nums.Swap(lastNonZero, curr)
            lastNonZero++
        }
    }
}

func main() {
    mut nums := []int{0,1,0,3,12}
    moveZeroes(mut nums)
    for i, e := range []int{1,3,12,0,0} {
        assertEq(nums[i], e)
    }
}