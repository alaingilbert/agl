package main

func moveZeroes(mut nums []int)  {
    mut lastNonZero, mut curr := 0, 0
    for curr < nums.Len() {
        if nums[curr] != 0 {
            nums[lastNonZero], nums[curr] = nums[curr], nums[lastNonZero]
            lastNonZero++
        }
        curr++
    }
}

func main() {
    mut nums := []int{0,1,0,3,12}
    moveZeroes(mut nums)
    for i, e := range []int{1,3,12,0,0} {
        assertEq(nums[i], e)
    }
}