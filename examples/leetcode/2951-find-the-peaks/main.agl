package main

func findPeaks(mountain []int) []int {
    mountain.
        Enumerated().
        Filter(|(i, _)| i >= 1 && i < mountain.Len()-1).
        FilterMap(|(i, _)| { if mountain[i] > mountain[i-1] && mountain[i] > mountain[i+1] { Some(i) } else { None } })
}

func main() {
    print(findPeaks([]int{1,4,3,8,5}))
}