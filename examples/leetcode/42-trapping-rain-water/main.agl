package main

func trap(height []int) int {
    mut left, mut right := 0, height.Len()-1
    mut out := 0
    mut leftMax, mut rightMax := 0, 0
    for left < right {
        if height[left] < height[right] {
            leftMax = max(leftMax, height[left])
            out += leftMax - height[left]
            left++
        } else {
            rightMax = max(rightMax, height[right])
            out += rightMax - height[right]
            right--
        }
    }
    return out
}

func main() {
    assertEq(trap([]int{0,1,0,2,1,0,1,3,2,1,2,1}), 6)
    assertEq(trap([]int{4,2,0,3,2,5}), 9)
    assertEq(trap([]int{2, 0, 2}), 2)
    assertEq(trap([]int{4, 2, 3}), 1)
}