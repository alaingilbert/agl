package main

func searchInsert(nums []int, target int) int {
    mut l, mut r := 0, nums.Len()-1
    for l <= r {
        mid := (l + r) / 2
        if nums[mid] == target {
            return mid
        } else if nums[mid] > target {
            r = mid - 1
        } else {
            l = mid + 1
        }
    }
    return l
}

func main() {
    assertEq(searchInsert([]int{1,3,5,6}, 5), 2)
    assertEq(searchInsert([]int{1,3,5,6}, 2), 1)
    assertEq(searchInsert([]int{1,3,5,6}, 7), 4)
}