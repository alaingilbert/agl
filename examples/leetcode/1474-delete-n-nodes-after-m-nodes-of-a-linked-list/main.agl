package main

type ListNode struct {
    Val int
    mut Next *ListNode
}

func deleteNodes(head *ListNode, m int, n int) *ListNode {
    mut node := &ListNode{Next: head}
    for node.Next != nil {
        for _ in 0..m where node.Next != nil {
            node = node.Next
        }
        mut p := node.Next
        for _ in 0..n where p != nil {
            p = p.Next
        }
        node.Next = p
    }
    return head
}

