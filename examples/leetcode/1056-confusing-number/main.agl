package main

func confusingNumber(n int) bool {
    var mut nn int
    cache := map[int]int{0: 0, 1: 1, 6: 9, 8: 8, 9: 6}
    mut nCopy := n
    for nCopy > 0 {
        if let Some(o) := cache.Get(nCopy % 10) {
            nn = nn * 10 + o
        } else {
            return false
        }
        nCopy /= 10
    }
    return nn != n
}

func main() {
    assert(confusingNumber(6))
    assert(confusingNumber(89))
    assert(!confusingNumber(11))
}