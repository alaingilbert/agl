package main

func isPalindrome(x int) bool {
    if x < 0 || x % 10 == 0 && x != 0 {
        return false
    }
    mut x := x
    mut reverted := 0
    for x > reverted {
        reverted = reverted * 10 + x % 10
        x /= 10
    }
    return reverted == x || x == reverted / 10
}

func main() {
    assert(isPalindrome(121))
    assert(!isPalindrome(-121))
    assert(!isPalindrome(10))
}