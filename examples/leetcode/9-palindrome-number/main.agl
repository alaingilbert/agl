package main

func isPalindrome(x int) bool {
    if x < 0 || x % 10 == 0 && x != 0 {
        return false
    }
    mut xx := x
    mut reverted := 0
    for xx > reverted {
        reverted = reverted * 10 + xx % 10
        xx /= 10
    }
    return reverted == xx || xx == reverted / 10
}

func main() {
    assert(isPalindrome(121))
    assert(!isPalindrome(-121))
    assert(!isPalindrome(10))
}