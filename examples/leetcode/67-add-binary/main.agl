package main

func addBinary(aa string, bb string) string {
    n := max(aa.Len(), bb.Len())
    a, b := aa.ZFill(n), bb.ZFill(n)
    var mut answer []string
    mut carry := 0
    for i in (0..a.Len()).Rev() {
        carry += if a[i] == '1' { 1 } else { 0 }
        carry += if b[i] == '1' { 1 } else { 0 }
        answer.Push(if carry % 2 == 1 { "1" } else { "0" })
        carry /= 2
    }
    if carry == 1 {
        answer.Push("1")
    }
    return answer.Reversed().Joined("")
}

func main() {
    assertEq(addBinary("11", "1"), "100")
    assertEq(addBinary("1010", "1011"), "10101")
}