package main

type TreeNode struct {
    Val int
    Left *TreeNode
    Right *TreeNode
}

 func helper(root *TreeNode, depth int) int {
    if root == nil {
        return depth
    }
    a := helper(root.Left, depth+1)
    b := helper(root.Right, depth+1)
    if abs(a-b) > 1 {
        return -1
    }
    return max(a, b)
}

func isBalanced(root *TreeNode) bool {
    return helper(root, 0) != -1
}

func main() {
}