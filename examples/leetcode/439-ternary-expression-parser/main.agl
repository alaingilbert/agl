package main

func parseTernary(expression string) string {
    mut chars := expression.Split("")
    mut ans := "F"
    mut it := chars.Iter().Peekable()
    for {
        c := it.Next()?
        n := it.Peek()
        if (c != "F" && c != "T") || n.IsNone() || n? == ":" {
            return c
        }
        if c == "T" {
            it.Next()
        } else {
            mut count := 1
            it.Next()
            for count > 0 {
                n := it.Next()?
                if n == ":" {
                    count -= 1
                } else if n == "?" {
                    count += 1
                }
            }
        }
    }
    return ans
}

func main() {
    assertEq(parseTernary("T?2:3"), "2")
    assertEq(parseTernary("F?1:T?4:5"), "4")
    assertEq(parseTernary("T?T?F:5:3"), "F")
    assertEq(parseTernary("T?T:F?T?1:2:F?3:4"), "T")
    assertEq(parseTernary("F?T:F?T?1:2:F?3:4"), "4")
    assertEq(parseTernary("F?F?9:T?F?F?F?F?F?9:9:2:6:6:F:0:F"), "F")
    assertEq(parseTernary("F?1:F?T?1:F?T?5:0:T?T?T?7:T:F?F?F?F?T?9:T?0:T?1:2:F?T?1:T?T?8:F:4:F?T?T?F?T?T?F?T?T?F?8:" +
        "F?9:8:0:F?3:2:7:T:F?T?T?T?T?F?T:4:6:T?7:T?F?F?T:5:5:6:5:F?T:0:T?T?F?F?T?T?T?7:F?T?F?T?T?7:2:F?T?3:6:F?T?2:F:5:" +
        "F?F:0:4:1:2:8:8:0:6:F:4:T:T:F:2:T:4:4:T"), "T")
}