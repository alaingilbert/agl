package main

func findDifference(nums1 []int, nums2 []int) [][]int {
    mut out := [][]int{}
    s1 := Set(nums1)
    s2 := Set(nums2)
    out.Push(Array(s1.Subtracting(s2).Iter()))
    out.Push(Array(s2.Subtracting(s1).Iter()))
    return out
}

func main() {
    print(findDifference([]int{1,2,3}, []int{2,4,6}))     // [[1 3] [4 6]]
    print(findDifference([]int{1,2,3,3}, []int{1,1,2,2})) // [[3] []]
}