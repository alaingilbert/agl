package main

func isMatch(s string, p string) bool {
    if s.Len() == 0 && p.Len() == 0 {
        return true
    } else if s.Len() == 0 && p.Len() >= 2 && p[1] == '*' {
        return isMatch(s, p[2:])
    } else if s.Len() == 0 || p.Len() == 0 {
        return false
    }
    if p.Len() >= 2 && p[1] == '*' {
        return isMatch(s, p[2:]) || ((s[0] == p[0] || p[0] == '.') && isMatch(s[1:], p))
    } else if s[0] == p[0] || p[0] == '.' {
        return isMatch(s[1:], p[1:])
    } else {
        return false
    }
}

func main() {
    assert(!isMatch("aa", "a"))
    assert(isMatch("aa", "a*"))
    assert(isMatch("ab", ".*"))
    assert(isMatch("aab", "c*a*b"))
    assert(!isMatch("ab", ".*c"))
    assert(isMatch("aaa", "a*a"))
    assert(isMatch("aaa", "a*aaa"))
    assert(isMatch("aaa", "ab*ac*a"))
    assert(!isMatch("b", "aaa."))
    assert(isMatch("aabcbcbcaccbcaabc", ".*a*aa*.*b*.c*.*a*"))
    assert(!isMatch("mississippi", "mis*is*p*."))
}