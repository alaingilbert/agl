package main

func isMatch(s string, p string) bool {
    if p.Len() == 0 {
        return s.Len() == 0
    }
    firstMatch := s.Len() > 0 && (s[0] == p[0] || p[0] == '.')
    if p.Len() >= 2 && p[1] == '*' {
        return isMatch(s, p[2:]) || (firstMatch && isMatch(s[1:], p))
    }
    return firstMatch && isMatch(s[1:], p[1:])
}

func main() {
    assert(!isMatch("aa", "a"))
    assert(isMatch("aa", "a*"))
    assert(isMatch("ab", ".*"))
    assert(isMatch("aab", "c*a*b"))
    assert(!isMatch("ab", ".*c"))
    assert(isMatch("aaa", "a*a"))
    assert(isMatch("aaa", "a*aaa"))
    assert(isMatch("aaa", "ab*ac*a"))
    assert(!isMatch("b", "aaa."))
    assert(isMatch("aabcbcbcaccbcaabc", ".*a*aa*.*b*.c*.*a*"))
    assert(!isMatch("mississippi", "mis*is*p*."))
}