package main

func lengthOfLongestSubstringTwoDistinct(s string) int {
    mut m := make(map[byte]int)
    mut left, mut right, mut ans := 0, 0, 0
    n := s.Len()
    if n < 3 {
        return n
    }
    for left < s.Len() && right < s.Len() {
        m[s[right]]++
        right++
        if m.Len() > 2 {
            c := s[left]
            m[c]--
            if m[c] == 0 {
                delete(m, c)
            }
            left++
        }
        ans = max(ans, right-left)
    }
    return ans
}

func main() {
    assertEq(lengthOfLongestSubstringTwoDistinct(""), 0)
    assertEq(lengthOfLongestSubstringTwoDistinct("a"), 1)
    assertEq(lengthOfLongestSubstringTwoDistinct("eceba"), 3)
    assertEq(lengthOfLongestSubstringTwoDistinct("ccaabbb"), 5)
}