package main

func stringShift(s string, shift [][]int) string {
    mut a := s.Split("")
    n := a.Len()
    for el in shift {
        direction, amount := el[0], el[1]
        for _ in 0..amount {
            v := if direction == 0 { 1 } else { n-1 }
            a = a[v:] + a[:v]
        }
    }
    return a.Joined("")
}

func main() {
    assertEq(stringShift("abc", [][]int{{0,1},{1,2}}), "cab")
    assertEq(stringShift("abcdefg", [][]int{{1,1},{1,1},{0,2},{1,3}}), "efgabcd")
    assertEq(stringShift("a", [][]int{{1,1},{1,1},{0,2},{1,3},{0,0}}), "a")
}