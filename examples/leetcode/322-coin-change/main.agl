package main

func coinChange(coins []int, amount int) int {
    mut dp := make([]int, amount+1)
    dp.Enumerated().ForEach(|(i, _)| dp[i] = amount+1)
    dp[0] = 0
    for coin in coins {
        for x in coin..amount+1 {
            dp[x] = min(dp[x], dp[x-coin] + 1)
        }
    }
    return if dp[amount] != amount+1 { dp[amount] } else { -1 }
}

func main() {
    assertEq(coinChange([]int{1,2,5}, 11), 3)
    assertEq(coinChange([]int{2}, 3), -1)
    assertEq(coinChange([]int{1}, 0), 0)
}