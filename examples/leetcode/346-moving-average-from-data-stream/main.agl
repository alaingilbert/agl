package main

type MovingAverage struct {
    size int
    mut vals []int
    mut count int
}

func Constructor(size int) MovingAverage {
    return MovingAverage{size: size, vals: make([]int, size)}
}

func (mut this *MovingAverage) Next(val int) f64 {
    this.vals[this.count % this.size] = val
    this.count++
    sum := this.vals.Sum()
    return f64(sum) / f64(min(this.count, this.size))
}

func main() {
}