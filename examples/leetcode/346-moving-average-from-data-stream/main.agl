package main

type MovingAverage struct {
    size int
    mut vals []int
    mut count int
    mut windowSum int
}

func Constructor(size int) MovingAverage {
    return MovingAverage{size: size, vals: make([]int, size)}
}

func (mut this *MovingAverage) Next(val int) f64 {
    idx := this.count % this.size
    prev := this.vals[idx]
    this.vals[idx] = val
    this.count++
    this.windowSum = this.windowSum - prev + val
    return f64(this.windowSum) / f64(min(this.count, this.size))
}

func main() {
}