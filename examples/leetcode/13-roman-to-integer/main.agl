package main

func romanToInt(s string) int {
    mut res := 0
    m := map[string]int{
        "M":  1000,
        "CM": 900,
        "D":  500,
        "CD": 400,
        "C":  100,
        "XC": 90,
        "L":  50,
        "XL": 40,
        "X":  10,
        "IX": 9,
        "V":  5,
        "IV": 4,
        "I":  1,
    }
    mut i := 0
    for i < s.Len() {
        c := string(s[i])
        var mut next = ""
        if i+1 < s.Len() {
            next = string(s[i+1])
        }
        comb := c + next
        if let Some(v) := m.Get(comb) {
            res += v
            i += 2
        } else if let Some(v) := m.Get(c) {
            res += v
            i++
        }
    }
    return res
}

func main() {
    assertEq(romanToInt("III"), 3)
    assertEq(romanToInt("LVIII"), 58)
    assertEq(romanToInt("MCMXCIV"), 1994)
}