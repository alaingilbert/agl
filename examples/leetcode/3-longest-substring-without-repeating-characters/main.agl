package main

func lengthOfLongestSubstring(s string) int {
    mut seen := set[byte]{}
    var mut l, mut res int
    for r in 0..s.Len() {
        for seen.Contains(byte(s[r])) {
            seen.Remove(byte(s[l]))
            l++
        }
        seen.Insert(byte(s[r]))
        res = max(res, r - l + 1)
    }
    return res
}

func main() {
    assert(lengthOfLongestSubstring("abcabcbb") == 3)
    assert(lengthOfLongestSubstring("bbbbb")    == 1)
    assert(lengthOfLongestSubstring("pwwkew")   == 3)
    assert(lengthOfLongestSubstring("dvdf")     == 3)
    assert(lengthOfLongestSubstring("nfpdmpi")  == 5)
}