package main

func lengthOfLongestSubstring(s string) int {
    mut seen := set[byte]{}
    var mut l, mut res int
    for r in 0..s.Len() {
        for seen.Contains(s[r]) {
            seen.Remove(s[l])
            l++
        }
        seen.Insert(s[r])
        res = max(res, r - l + 1)
    }
    return res
}

func main() {
    assertEq(lengthOfLongestSubstring("abcabcbb"), 3)
    assertEq(lengthOfLongestSubstring("bbbbb"),    1)
    assertEq(lengthOfLongestSubstring("pwwkew"),   3)
    assertEq(lengthOfLongestSubstring("dvdf"),     3)
    assertEq(lengthOfLongestSubstring("nfpdmpi"),  5)
}