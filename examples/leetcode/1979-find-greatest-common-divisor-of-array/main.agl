package main

func findGCD(nums []int) int {
    minNum := nums.Min()?
    maxNum := nums.Max()?
    for i in (1..=maxNum).Rev() {
        if minNum % i == 0 && maxNum % i == 0 {
            return i
        }
    }
    return 0
}

func main() {
    assertEq(findGCD([]int{2,5,6,9,10}), 2)
    assertEq(findGCD([]int{7,5,6,8,3}), 1)
    assertEq(findGCD([]int{3,3}), 3)
}