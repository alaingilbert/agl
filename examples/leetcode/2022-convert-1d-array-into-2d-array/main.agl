package main

func construct2DArray(original []int, m int, n int) [][]int {
    if m * n != original.Len() {
        return [][]int{}
    }
    mut out := [][]int{}
    for i := 0; i < m; i++ {
        out.Push(original[i*n:i*n+n])
    }
    return out
}

