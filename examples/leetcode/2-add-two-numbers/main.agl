package main

type ListNode struct {
    mut Val int
    mut Next *ListNode
}

func (l *ListNode) String() string {
    mut out := []int{l.Val}
    mut n := l
    for n.Next != nil {
        n = n.Next
        out.Push(n.Val)
    }
    return out.Map({ $0.String() }).Joined(",")
}

func NewListNode(s string) *ListNode {
    var mut next *ListNode
    for val in s.Split(",").Reversed() {
        next = &ListNode{Val: val.Int()?, Next: next}
    }
    return next
}

func addTwoNumbers(l1 *ListNode, l2 *ListNode) *ListNode {
    return helper(l1, l2, 0)
}

func helper(l1 *ListNode, l2 *ListNode, rem int) *ListNode {
    mut h1, mut h2 := l1, l2
    mut v := h1.Val + h2.Val + rem
    rem1 := v / 10
    v %= 10
    var mut next *ListNode
    if h1.Next != nil || h2.Next != nil {
        h1.Next = h1.Next ?? &ListNode{}
        h2.Next = h2.Next ?? &ListNode{}
        next = helper(h1.Next, h2.Next, rem1)
    } else if rem1 > 0 {
        next = &ListNode{Val: rem1}
    }
    return &ListNode{Val: v, Next: next}
}

func main() {
    mut l1 := NewListNode("2,4,3")
    mut l2 := NewListNode("5,6,4")
    mut l3 := NewListNode("7,0,8")
    assertEq(addTwoNumbers(l1, l2).String(), l3.String())

    l1 = NewListNode("9,9,9,9,9,9,9")
    l2 = NewListNode("9,9,9,9")
    l3 = NewListNode("8,9,9,9,0,0,0,1")
    assertEq(addTwoNumbers(l1, l2).String(), l3.String())
}