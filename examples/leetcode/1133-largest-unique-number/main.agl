package main

func largestUniqueNumber(nums []int) int {
    mut m := make(map[int]int)
    for e in nums {
        m[e]++
    }
    return m.Filter({ $0.Value == 1 }).Map({ $0.Key }).Max().UnwrapOr(-1)
}

func main() {
    assertEq(largestUniqueNumber([]int{5,7,3,9,4,9,8,3,1}), 8)
    assertEq(largestUniqueNumber([]int{9,9,8,8}), -1)
}