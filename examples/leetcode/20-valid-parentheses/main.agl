package main

func isValid(s string) bool {
    mut q := make([]rune, 0)
    m := map[rune]rune {'(': ')', '[': ']', '{': '}'}
    for c in s {
        if c in m {
            q.Push(c)
            continue
        }
        guard let Some(o) := q.Pop() else { return false }
        if c != m[o] {
            return false
        }
    }
    return q.IsEmpty()
}

func main() {
    assert(isValid("()"))
    assert(isValid("()[]{}"))
    assert(!isValid("(]"))
    assert(isValid("([])"))
    assert(!isValid("([)]"))
    assert(!isValid("["))
    assert(!isValid("]"))
}