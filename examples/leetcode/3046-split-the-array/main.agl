package main

func isPossibleToSplit(nums []int) bool {
    mut h := make(map[int]int)
    for n in nums {
        h[n]++
        if h[n] > 2 {
            return false
        }
    }
    return true
}

func main() {
    assert(isPossibleToSplit([]int{1,1,2,2,3,4}))
    assert(!isPossibleToSplit([]int{1,1,1,1}))
}