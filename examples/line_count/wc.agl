package main

import "agl/os"

// Returns the line count of a filename using a result type
func countLines(filename string) int! {
    content := string(os.ReadFile(filename)!)

    // Count total lines (wc -l compatible)
    totalCount := content.Lines().Len() - 1

    return Ok(totalCount)
}

func main() {
    // Get filename from command line arguments
    if len(os.Args) < 2 {
        print("usage: wc <filename>")
        return
    }

    filename := os.Args[1]

    match countLines(filename) {
    case Ok(total):
        printf("%8d %s", total, filename)
    case Err(err):
        printf("wc: %s: %s", filename, err)
    }
}
