package main

import "agl/os"

var mut data [][]string
var mut width, mut height int
var mut antenasDict = map[string][](int, int){}

func main() {
    fileContent := os.ReadFile("examples/adventOfCode2024/day8/data.txt")!
    data = fileContent.String().Lines().Map({ $0.Split("") })
    width = data.Len()
    height = data.First()?.Len()
    for (y, row) in data.Enumerated() {
        for (x, col) in row.Enumerated() where col != "." && col != "#" {
            antenasDict[col].Push((x, y))
        }
    }
    part1()
    part2()
}

func part1() {
    mut antinodes := set[(int, int)]{}
    for antenas in antenasDict.Values() {
        for a1 in antenas {
            for a2 in antenas where a2 != a1 {
                dx := a2.0 - a1.0
                dy := a2.1 - a1.1
                pos := (a2.0 + dx, a2.1 + dy)
                if pos.0 >= 0 && pos.0 < width && pos.1 >= 0 && pos.1 < height {
                    antinodes.Insert(pos)
                }
            }
        }
    }
    print(antinodes.Len())
}

func part2() {
    mut antinodes := set[(int, int)]{}
    for antenas in antenasDict.Values() {
        for a1 in antenas {
            for a2 in antenas where a2 != a1 {
                dx := a2.0 - a1.0
                dy := a2.1 - a1.1
                pos := (a2.0, a2.1)
                for pos.0 >= 0 && pos.0 < width && pos.1 >= 0 && pos.1 < height {
                    antinodes.Insert(pos)
                    pos.0 += dx
                    pos.1 += dy
                }
            }
        }
    }
    print(antinodes.Len())
}